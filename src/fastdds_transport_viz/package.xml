<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fastdds_transport_viz</name>
  <version>1.0.0</version>
  <description>
    Shows which Fast DDS transport (UDPv4, SHM, data-sharing, ...) each ROS 2 topic is
    communicated over, and why, using Fast DDS discovery data and optionally the
    Fast DDS statistics module.
  </description>
  <maintainer email="dandelion1124@gmail.com">atinfinity</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend condition="$ROS_DISTRO == humble or $ROS_DISTRO == jazzy">fastrtps</depend>
  <depend condition="$ROS_DISTRO != humble and $ROS_DISTRO != jazzy">fastdds</depend>
  <depend>fastcdr</depend>
  <depend>nlohmann-json-dev</depend>

  <exec_depend>rmw_fastrtps_cpp</exec_depend>
  <exec_depend>demo_nodes_cpp</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>launch</test_depend>
  <test_depend>launch_ros</test_depend>
  <test_depend>launch_testing</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend>launch_testing_ros</test_depend>
  <test_depend>python3-jsonschema</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
