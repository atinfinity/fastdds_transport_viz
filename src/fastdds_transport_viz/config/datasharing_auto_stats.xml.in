<?xml version="1.0" encoding="UTF-8" ?>
<!-- datasharing_auto.xml + statistics.xml in one file: Fast DDS reads a single
     FASTRTPS_DEFAULT_PROFILES_FILE, so use this one to observe data-sharing with - -stats.
       export FASTRTPS_DEFAULT_PROFILES_FILE=$(ros2 pkg prefix fastdds_transport_viz)/share/fastdds_transport_viz/config/datasharing_auto_stats.xml
       export RMW_FASTRTPS_USE_QOS_FROM_XML=1
       export FASTDDS_STATISTICS="RTPS_SENT_TOPIC;RTPS_LOST_TOPIC;HISTORY_LATENCY_TOPIC;PHYSICAL_DATA_TOPIC;DATA_COUNT_TOPIC;RESENT_DATAS_TOPIC;HEARTBEAT_COUNT_TOPIC;ACKNACK_COUNT_TOPIC;NACKFRAG_COUNT_TOPIC;GAP_COUNT_TOPIC"
     Keep the ds_writer/ds_reader profiles in sync with datasharing_auto.xml. Like
     statistics.xml, the installed file is generated from this template: CMake pastes the
     statistics writer profiles of config/statistics_writers.xml.in in place of
     FTV_STATS_WRITER_PROFILES (heartbeat period on Fast DDS 3.x, #152; one source, #159).
     The writers run in push mode on the statistics flow controller on purpose: see the
     comment in statistics.xml.in (#154). -->
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <profiles>
    <data_writer profile_name="ds_writer" is_default_profile="true">
      <qos><data_sharing><kind>AUTOMATIC</kind></data_sharing></qos>
      <historyMemoryPolicy>PREALLOCATED_WITH_REALLOC</historyMemoryPolicy>
    </data_writer>
    <data_reader profile_name="ds_reader" is_default_profile="true">
      <qos><data_sharing><kind>AUTOMATIC</kind></data_sharing></qos>
      <historyMemoryPolicy>PREALLOCATED_WITH_REALLOC</historyMemoryPolicy>
    </data_reader>
@FTV_STATS_WRITER_PROFILES@
  </profiles>
</dds>
