{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/atinfinity/fastdds_transport_viz/schema/transport_viz.schema.json",
  "title": "transport_viz --json output (schema_version 1)",
  "description": "Minimal contract that front-ends rely on. Unknown keys are allowed so the tool can add fields without a schema bump; a breaking change bumps schema_version.",
  "type": "object",
  "required": [
    "schema_version",
    "domain",
    "observed_at",
    "observation_seconds",
    "local_host_id",
    "topics",
    "reason_code_descriptions",
    "reason_code_remedies",
    "stats"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "domain": {
      "type": "integer",
      "minimum": 0
    },
    "observed_at": {
      "type": "string"
    },
    "observation_seconds": {
      "type": "number",
      "minimum": 0
    },
    "local_host_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}$"
    },
    "topics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/topic"
      }
    },
    "reason_code_descriptions": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "reason_code_remedies": {
      "description": "What to change to get past each code of reason_code_descriptions (same keys); null when the code describes a normal state or asks for a bug report.",
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "stats": {
      "$ref": "#/$defs/stats"
    },
    "changes": {
      "$ref": "#/$defs/changes"
    },
    "shm": {
      "$ref": "#/$defs/shm"
    },
    "discovery": {
      "$ref": "#/$defs/discovery"
    }
  },
  "$defs": {
    "transport": {
      "enum": [
        "UDPv4",
        "UDPv6",
        "TCPv4",
        "TCPv6",
        "SHM",
        "DATA_SHARING",
        "NONE"
      ]
    },
    "confidence": {
      "enum": [
        "certain",
        "likely"
      ]
    },
    "locatorKind": {
      "enum": [
        "UDPv4",
        "UDPv6",
        "TCPv4",
        "TCPv6",
        "SHM",
        "INVALID"
      ]
    },
    "code": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "locator": {
      "type": "object",
      "required": [
        "kind",
        "address",
        "port"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/locatorKind"
        },
        "address": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "selectedLocator": {
      "type": "object",
      "description": "The reader locator the prediction selected: the address, or for SHM the /dev/shm port, the writer will deliver to. null when none was selected: a DATA_SHARING or NONE verdict, or Fast DDS < 2.10 hiding a same-host peer's locators.",
      "required": [
        "kind",
        "address",
        "port",
        "multicast"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/locatorKind"
        },
        "address": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 0
        },
        "multicast": {
          "type": "boolean"
        }
      }
    },
    "measuredLocator": {
      "type": "object",
      "description": "One destination locator that carried packets to the reader. packets/bytes are deltas over the observation, so the entries sum to measurement.packets/bytes.",
      "required": [
        "kind",
        "address",
        "port",
        "packets",
        "bytes"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/locatorKind"
        },
        "address": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 0
        },
        "packets": {
          "type": "integer",
          "minimum": 0
        },
        "bytes": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "endpoint": {
      "type": "object",
      "required": [
        "guid",
        "participant_guid_prefix",
        "host_id",
        "host",
        "node",
        "dds_topic",
        "dds_type",
        "ros_topic",
        "ros_type",
        "unicast_locators",
        "multicast_locators",
        "qos"
      ],
      "properties": {
        "guid": {
          "type": "string"
        },
        "participant_guid_prefix": {
          "type": "string"
        },
        "host_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}$"
        },
        "host": {
          "type": "string"
        },
        "host_name": {
          "type": "string"
        },
        "process": {
          "type": "string"
        },
        "node": {
          "type": "string"
        },
        "dds_topic": {
          "type": "string"
        },
        "dds_type": {
          "type": "string"
        },
        "ros_topic": {
          "type": "string"
        },
        "ros_type": {
          "type": "string"
        },
        "buffer_parent_guid": {
          "type": "string",
          "description": "rmw_fastrtps_cpp native-buffer companion (<topic>/_buf_cpu): the guid of the writer or reader of the parent topic whose samples it carries; absent for other endpoints"
        },
        "unicast_locators": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/locator"
          }
        },
        "multicast_locators": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/locator"
          }
        },
        "qos": {
          "type": "object",
          "required": [
            "reliability",
            "durability",
            "data_sharing"
          ],
          "properties": {
            "reliability": {
              "type": "string"
            },
            "durability": {
              "type": "string"
            },
            "data_sharing": {
              "enum": [
                "OFF",
                "ON",
                "AUTO",
                "UNKNOWN"
              ]
            },
            "data_sharing_domain_ids": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "deadline_s": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "description": "deadline period; null = infinite"
            },
            "liveliness": {
              "type": "string",
              "description": "AUTOMATIC / MANUAL_BY_PARTICIPANT / MANUAL_BY_TOPIC"
            },
            "liveliness_lease_s": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "description": "liveliness lease duration; null = infinite"
            },
            "ownership": {
              "type": "string",
              "description": "SHARED / EXCLUSIVE"
            },
            "partitions": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "partition names; empty = the default partition"
            }
          }
        },
        "datasharing_history_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "size of the writer's data-sharing history file in the tool's /dev/shm; null when there is none"
        }
      }
    },
    "measurement": {
      "type": "object",
      "required": [
        "available",
        "transports",
        "locators",
        "packets",
        "bytes",
        "delivered"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "transports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/transport"
          }
        },
        "locators": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/measuredLocator"
          }
        },
        "packets": {
          "type": "integer",
          "minimum": 0,
          "description": "RTPS packets to the reader's locators during the observation"
        },
        "bytes": {
          "type": "number",
          "minimum": 0,
          "description": "RTPS bytes to the reader's locators during the observation"
        },
        "delivered": {
          "type": "boolean"
        },
        "delivered_samples": {
          "type": "integer",
          "minimum": 0,
          "description": "HISTORY_LATENCY samples seen for this pair during the observation"
        },
        "data_submessages": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "DATA/DATA_FRAG submessages the writer sent through a transport during the observation (DATA_COUNT delta); null when the writer's participant does not publish DATA_COUNT"
        },
        "packets_total": {
          "type": "integer",
          "minimum": 0,
          "description": "RTPS packets to the reader's locators since the writer's participant started"
        },
        "bytes_total": {
          "type": "number",
          "minimum": 0,
          "description": "RTPS bytes to the reader's locators since the writer's participant started"
        },
        "throughput_bytes_per_s": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "description": "removed in #137 and always null: PUBLICATION_THROUGHPUT is a per-write payload/interval sample, not a rate, and is no longer subscribed. The key is kept so earlier documents keep validating."
        },
        "latency_s": {
          "type": [
            "object",
            "null"
          ],
          "description": "HISTORY_LATENCY of this pair over the observation, seconds; null without values",
          "properties": {
            "mean": {
              "type": "number"
            },
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "last": {
              "type": "number"
            },
            "samples": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "reliability": {
          "type": [
            "object",
            "null"
          ],
          "description": "reliability counters over the observation (window deltas); null without counters",
          "properties": {
            "lost_packets": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "description": "RTPS_LOST packets the reader's participant missed from the writer's participant on the reader's unicast locators (shared by every pair of the two participants); null when the reader's participant does not publish RTPS_LOST"
            },
            "resent_datas": {
              "type": "integer",
              "minimum": 0
            },
            "heartbeats": {
              "type": "integer",
              "minimum": 0
            },
            "gaps": {
              "type": "integer",
              "minimum": 0
            },
            "acknacks": {
              "type": "integer",
              "minimum": 0
            },
            "nackfrags": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "pair": {
      "type": "object",
      "required": [
        "writer_guid",
        "reader_guid",
        "writer_node",
        "reader_node",
        "writer_host",
        "reader_host",
        "transport",
        "locator",
        "confidence",
        "reasons",
        "warnings",
        "measured"
      ],
      "properties": {
        "writer_guid": {
          "type": "string"
        },
        "reader_guid": {
          "type": "string"
        },
        "writer_node": {
          "type": "string"
        },
        "reader_node": {
          "type": "string"
        },
        "writer_host": {
          "type": "string"
        },
        "reader_host": {
          "type": "string"
        },
        "transport": {
          "$ref": "#/$defs/transport"
        },
        "locator": {
          "oneOf": [
            {
              "$ref": "#/$defs/selectedLocator"
            },
            {
              "type": "null"
            }
          ]
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "reasons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/code"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/code"
          }
        },
        "measured": {
          "$ref": "#/$defs/measurement"
        }
      }
    },
    "topic": {
      "type": "object",
      "required": [
        "topic",
        "dds_topic",
        "type",
        "is_ros_topic",
        "unmatched_reasons",
        "writers",
        "readers",
        "pairs"
      ],
      "properties": {
        "topic": {
          "type": "string"
        },
        "dds_topic": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "is_ros_topic": {
          "type": "boolean"
        },
        "unmatched_reasons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/code"
          }
        },
        "writers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/endpoint"
          }
        },
        "readers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/endpoint"
          }
        },
        "pairs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pair"
          }
        },
        "throughput_bytes_per_s": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "description": "removed in #137 and always null; see the pair-level key of the same name"
        },
        "latency_s": {
          "type": [
            "number",
            "null"
          ],
          "description": "mean write-to-notification latency of the slowest pair (HISTORY_LATENCY, seconds); null without values"
        },
        "lost_packets": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "RTPS_LOST packets of the pairs during the observation, each stats.lost entry counted once; null when no pair has it"
        },
        "resent_datas": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "sum of the pairs' RESENT_DATAS during the observation; null without counters"
        }
      }
    },
    "stats": {
      "type": "object",
      "required": [
        "enabled",
        "samples",
        "participants_with_stats",
        "physical",
        "traffic"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "samples": {
          "type": "integer",
          "minimum": 0
        },
        "participants_with_stats": {
          "description": "GUID prefixes of the participants that published a statistics sample the tool received (not those only named in one). Output of earlier versions can also list the participants named in a sample, the tool's own among them (#113).",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "physical": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "host",
              "user",
              "process"
            ],
            "properties": {
              "host": {
                "type": "string"
              },
              "user": {
                "type": "string"
              },
              "process": {
                "type": "string"
              }
            }
          }
        },
        "traffic": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "src_participant_guid_prefix",
              "dst_locator",
              "packets",
              "bytes"
            ],
            "properties": {
              "src_participant_guid_prefix": {
                "type": "string"
              },
              "dst_locator": {
                "$ref": "#/$defs/locator"
              },
              "packets": {
                "type": "integer",
                "minimum": 0
              },
              "bytes": {
                "type": "number",
                "minimum": 0
              },
              "packets_first": {
                "type": "integer",
                "minimum": 0,
                "description": "cumulative RTPS_SENT packets at the first sample of the observation"
              },
              "bytes_first": {
                "type": "number",
                "minimum": 0,
                "description": "cumulative RTPS_SENT bytes at the first sample of the observation"
              }
            }
          }
        },
        "data_count": {
          "type": "object",
          "description": "writer guid -> cumulative DATA_COUNT at the first and last sample seen",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "first": {
                "type": "integer"
              },
              "last": {
                "type": "integer"
              },
              "samples": {
                "type": "integer"
              }
            },
            "required": [
              "first",
              "last",
              "samples"
            ]
          }
        },
        "throughput": {
          "type": "object",
          "description": "removed in #137 and always empty: PUBLICATION_THROUGHPUT is no longer subscribed",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "mean": {
                "type": "number"
              },
              "last": {
                "type": "number"
              },
              "samples": {
                "type": "integer"
              }
            },
            "required": [
              "mean",
              "last",
              "samples"
            ]
          }
        },
        "samples_lost": {
          "type": "integer",
          "minimum": 0,
          "description": "statistics samples that never reached the tool because the writers' keep-last history overwrote them before it read them (#134): a pair can show no measurement although it carries traffic. Cumulative over the run. Not to be confused with `lost` above, which is what the observed system lost (RTPS_LOST)."
        },
        "samples_lost_at_start": {
          "type": "integer",
          "minimum": 0,
          "description": "statistics samples lost while the writers were still matching the tool's readers (#134): everything a writer's history had already dropped before the match is reported to the new reader. Normal, and excluded from the stats-samples-lost warning."
        },
        "samples_rejected": {
          "type": "integer",
          "minimum": 0,
          "description": "statistics samples a resource limit of the tool's readers refused (#134); counted with samples_lost for the warning"
        },
        "writers_incompatible_qos": {
          "type": "integer",
          "minimum": 0,
          "description": "statistics DataWriters the tool's readers could not match because the writers' QoS is incompatible with theirs (#141). Nothing such a writer publishes ever arrives, and nothing is counted in samples_lost either: a reader is only told about the samples of writers it did match. Optional; documents written before #141 do not carry it."
        },
        "warnings": {
          "type": "array",
          "description": "document-level warning codes about the statistics observation: stats-samples-lost",
          "items": {
            "type": "string"
          }
        },
        "statistics_writers": {
          "type": "array",
          "description": "statistics DataWriters seen in discovery (participant prefix, topic)",
          "items": {
            "type": "object",
            "properties": {
              "participant_guid_prefix": {
                "type": "string"
              },
              "topic": {
                "type": "string"
              }
            }
          }
        },
        "lost": {
          "type": "array",
          "description": "RTPS_LOST: packets the reporting participant missed from a sending participant, per the reporter's own locator the sender addressed (cumulative, with the first sample of the observation)",
          "items": {
            "type": "object",
            "properties": {
              "reporter_participant_guid_prefix": {
                "type": "string",
                "description": "the receiving participant that published the sample"
              },
              "src_participant_guid_prefix": {
                "type": "string",
                "description": "the sending participant"
              },
              "dst_locator": {
                "$ref": "#/$defs/locator"
              },
              "packets": {
                "type": "integer",
                "minimum": 0
              },
              "bytes": {
                "type": "number",
                "minimum": 0
              },
              "packets_first": {
                "type": "integer",
                "minimum": 0
              },
              "bytes_first": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "pairKey": {
      "description": "Identity of a writer -> reader pair: the display topic name and the two endpoint GUIDs, with the nodes behind them (empty for an endpoint without a ROS node).",
      "type": "object",
      "required": [
        "topic",
        "writer_guid",
        "reader_guid",
        "writer_node",
        "reader_node"
      ],
      "properties": {
        "topic": {
          "type": "string"
        },
        "writer_guid": {
          "type": "string"
        },
        "reader_guid": {
          "type": "string"
        },
        "writer_node": {
          "type": "string"
        },
        "reader_node": {
          "type": "string"
        }
      }
    },
    "pairState": {
      "type": "object",
      "required": [
        "transport",
        "confidence",
        "measured",
        "locator",
        "measured_locators",
        "warnings"
      ],
      "properties": {
        "transport": {
          "$ref": "#/$defs/transport"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "measured": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/transport"
          }
        },
        "locator": {
          "oneOf": [
            {
              "$ref": "#/$defs/locator"
            },
            {
              "type": "null"
            }
          ]
        },
        "measured_locators": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/locator"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/code"
          }
        }
      }
    },
    "changes": {
      "description": "Pairs added, removed or changed between two snapshots. In --watch --json documents: since the previously emitted document (empty in the first one), pairs matched by GUID. In the output of `transport_viz diff --json`: between the before document (`before`) and this one, matched by `key`; the keys of added_pairs and changed_pairs are this document's, those of removed_pairs the before document's, and changed_pairs[].from names the pair's GUIDs in the before document.",
      "type": "object",
      "required": [
        "key",
        "added_pairs",
        "removed_pairs",
        "changed_pairs"
      ],
      "properties": {
        "key": {
          "description": "How the pairs of the two snapshots were matched: by (topic, writer GUID, reader GUID) or by (topic, writer node, reader node), which survives a restart of the nodes and ignores the locator port numbers a restart renumbers (`diff --key node`, the default of diff).",
          "enum": [
            "guid",
            "node"
          ]
        },
        "before": {
          "description": "The before document of `transport_viz diff` (absent in --watch output).",
          "type": "object",
          "required": [
            "observed_at",
            "domain"
          ],
          "properties": {
            "observed_at": {
              "type": "string"
            },
            "domain": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "added_pairs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pairKey"
          }
        },
        "removed_pairs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pairKey"
          }
        },
        "changed_pairs": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/pairKey"
              },
              {
                "type": "object",
                "required": [
                  "from",
                  "to"
                ],
                "properties": {
                  "from": {
                    "allOf": [
                      {
                        "$ref": "#/$defs/pairState"
                      },
                      {
                        "type": "object",
                        "description": "The state of the pair in the before document, with the GUIDs it had there (they differ from the key's after a restart of the nodes, under `key` = node).",
                        "required": [
                          "writer_guid",
                          "reader_guid"
                        ],
                        "properties": {
                          "writer_guid": {
                            "type": "string"
                          },
                          "reader_guid": {
                            "type": "string"
                          }
                        }
                      }
                    ]
                  },
                  "to": {
                    "$ref": "#/$defs/pairState"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "discovery": {
      "type": "object",
      "description": "how complete the observation behind this document is - a property of the observation, not of the observed system; absent in documents written before this field existed",
      "required": [
        "complete",
        "stopped_on",
        "events",
        "endpoints",
        "announced_not_discovered"
      ],
      "properties": {
        "complete": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "true when every endpoint the live participants announce in ros_discovery_info was discovered, false when some were missed (the run stopped too early), null when no live participant announced anything and nothing can be said either way"
        },
        "stopped_on": {
          "enum": [
            "quiet",
            "timeout"
          ],
          "description": "what ended the observation: a --quiet window without discovery events, or --timeout"
        },
        "events": {
          "type": "integer",
          "minimum": 0,
          "description": "discovery callbacks the observation saw"
        },
        "endpoints": {
          "type": "integer",
          "minimum": 0,
          "description": "remote endpoints discovered, before any view filter (--all, --topic, --node)"
        },
        "announced_not_discovered": {
          "type": "integer",
          "minimum": 0,
          "description": "endpoints announced by a live participant that discovery never delivered; 0 when complete is true"
        }
      }
    },
    "shm": {
      "type": "object",
      "description": "shared memory of the environment the tool runs in (statvfs of /dev/shm and the Fast DDS files in it); the sizes are absent when `available` is false",
      "required": [
        "available",
        "path",
        "warnings"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "path": {
          "type": "string"
        },
        "total_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "used_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "free_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "fastdds_bytes": {
          "type": "integer",
          "minimum": 0,
          "description": "sum of the fastrtps_* / fast_datasharing_* file sizes"
        },
        "segments": {
          "type": "integer",
          "minimum": 0
        },
        "stale_segments": {
          "type": "integer",
          "minimum": 0
        },
        "ports": {
          "type": "integer",
          "minimum": 0
        },
        "stale_ports": {
          "type": "integer",
          "minimum": 0
        },
        "datasharing_histories": {
          "type": "integer",
          "minimum": 0
        },
        "datasharing_unmatched": {
          "type": "integer",
          "minimum": 0
        },
        "datasharing_notifications": {
          "type": "integer",
          "minimum": 0,
          "description": "notification segments (fast_datasharing_<reader guid>) of discovered data-sharing readers, not counted in datasharing_histories"
        },
        "nodes_visible": {
          "type": "boolean",
          "description": "no missing port and no participant with another host id: the observed nodes share this /dev/shm"
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/code"
          }
        },
        "checked_ports": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "description": "SHM ports of observed nodes on the tool's host id that were probed here"
        },
        "missing_ports": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "description": "probed ports not held by a living process here (or the tool's own port number)"
        },
        "other_host_participants": {
          "type": "integer",
          "minimum": 0,
          "description": "observed participants with another host id: never in this /dev/shm"
        }
      }
    }
  }
}
