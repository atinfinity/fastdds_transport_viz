  "reason_code_descriptions": {
    "common-tcpv4-locator": "The reader announces a TCPv4 locator and the writer speaks TCPv4.",
    "different-host": "GUID prefixes differ in the first 4 bytes, so Fast DDS treats the endpoints as being on different hosts; shared memory is not an option.",
    "measured-tcpv4-traffic": "Statistics show RTPS packets from the writer's participant to the reader's TCPv4 locator.",
    "no-matching-reader": "No subscription was discovered for this topic.",
    "shm-not-visible": "Observed nodes announce SHM locators that are not open in this process's shared-memory directory (nobody holds the port's lock, the port number collides with the tool's own, or the node has another host id): they run in another IPC namespace or on another host, so the shared-memory figures describe this environment, not theirs, and SHM cannot be used between them and here. Nodes with the same host id in different IPC namespaces still pick SHM between themselves and lose every message; their pairs get shm-ipc-namespace-split when the nodes announce the same SHM port number or the tool shares the IPC namespace of one of them, and cannot be checked from here otherwise."
  },
  "reason_code_remedies": {
    "common-tcpv4-locator": null,
    "different-host": "For SHM between containers on one machine, run them in the host's network and IPC namespaces (--network host --ipc host); between machines only network transports apply.",
    "measured-tcpv4-traffic": null,
    "no-matching-reader": "Start a subscription on this topic, or check the topic name, namespace and remappings of the node expected to subscribe to it.",
    "shm-not-visible": "Run the tool where the nodes run (same host and IPC namespace: the same container, or --ipc=host on both) if the shared-memory line should describe their /dev/shm."
  },
